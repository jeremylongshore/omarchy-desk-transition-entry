#!/usr/bin/env bash
# Safe display scenes: only active, current Hyprland outputs are targeted.
set -euo pipefail
export LC_ALL=C
monitors() {
  local raw
  raw="$(timeout 3s hyprctl -j monitors 2>/dev/null | head -c 65537)" || { printf '[]'; return; }
  (( ${#raw} <= 65536 )) || { printf '[]'; return; }
  jq -c '[limit(8; .[]
    | select((.name | type) == "string" and (.name | length) <= 32 and (.name | test("^[A-Za-z0-9._-]+$")))
    | {name,
       width: ((.width // 0) | if type == "number" then (floor | if . < 0 then 0 elif . > 20000 then 20000 else . end) else 0 end),
       height: ((.height // 0) | if type == "number" then (floor | if . < 0 then 0 elif . > 20000 then 20000 else . end) else 0 end),
       focused: (.focused == true)})]' <<<"$raw" 2>/dev/null || printf '[]'
}
scan() { jq -cn --argjson monitors "$(monitors)" '{monitors:$monitors}'; }
focus() { local name="$1"; monitors | jq -e --arg n "$name" '.[] | select(.name==$n)' >/dev/null || exit 2; hyprctl dispatch focusmonitor "$name"; scan; }
desk() { local x=0 name width; while IFS=$'\t' read -r name width; do hyprctl keyword monitor "$name,preferred,${x}x0,1"; x=$((x + width)); done < <(monitors | jq -r '.[] | [.name,(.width|tonumber)] | @tsv'); scan; }
laptop() { local name; name="$(monitors | jq -r '.[] | select(.name|test("^(eDP|LVDS)")) | .name' | head -n1)"; [[ -n "$name" ]] && focus "$name" || scan; }
case "${1:---scan}" in --scan) scan ;; --desk) desk ;; --laptop) laptop ;; --focus) focus "${2:-}" ;; *) exit 2 ;; esac
